{
  "name": "w3c-lol-desktop",
  "version": "0.3.17",
  "private": true,
  "description": "Pinkward Windows companion",
  "author": "Pinkward Contributors",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run typecheck && npm run build:electron && vite build",
    "build:electron": "node scripts/clean-electron-build.mjs && tsc -p tsconfig.electron.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:lcu:firstblood": "npm run build:electron && node scripts/probe-firstblood-1x1.mjs",
    "check": "npm run lint && npm run test && npm run build",
    "package:win": "npm run check && electron-builder --win --x64"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "9.2.4",
    "cross-env": "10.1.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "wait-on": "8.0.5"
  },
  "build": {
    "appId": "gg.w3c.lol.companion",
    "productName": "Pinkward",
    "asar": true,
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Alexis-Guyon/Pinkward-Luncher/releases/latest/download"
      }
    ],
    "forceCodeSigning": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release-artifacts"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "update-config.json",
        "to": "update-config.json"
      },
      {
        "from": "src/assets/pinkward-logo-final.png",
        "to": "pinkward-logo.png"
      }
    ],
    "win": {
      "icon": "src/assets/pinkward-logo-final.png",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      },
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Pinkward-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Pinkward-Portable-${version}-${arch}.${ext}"
    }
  }
}
